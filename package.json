{
  "name": "playwright-bdd-ui-framework",
  "version": "1.0.0",
  "scripts": {
    "test": "cucumber-js tests/features/**/*.feature",
    "test:smoke": "cucumber-js tests/features/**/*.feature --tags @smoke",
    "test:regression": "cucumber-js tests/features/**/*.feature --tags @regression",
    "test:ci": "cucumber-js tests/features/**/*.feature --parallel 2 --retry 2 --format progress --format summary",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@playwright/test": "^1.42.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
